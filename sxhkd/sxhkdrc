super + F12
	~/.local/bin/changevolume up

# Volume Down
super + F11
	~/.local/bin/changevolume down

# Mute
super + F10
	~/.local/bin/changevolume mute

# Physical Volume Up
XF86AudioRaiseVolume
	~/.local/bin/changevolume up

# Physical Volume Down
XF86AudioLowerVolume
	~/.local/bin/changevolume down

# Physical Mute
XF86AudioMute
	~/.local/bin/changevolume mute

# Brightness Up
XF86MonBrightnessUp
	xbacklight +10

# Brightness Down
XF86MonBrightnessDown
	xbacklight -10


# === SYSTEM ===

# Reload sxhkd
super + Escape
	pkill -USR1 -x sxhkd; notify-send 'sxhkd' 'Reloaded config'

# Power
super + End
	~/.local/bin/power
