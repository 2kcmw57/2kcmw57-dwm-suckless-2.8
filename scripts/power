```bash
#!/usr/bin/env bash

# ============================================================
# KCMW Power Menu
#
# Requirements:
#   rofi
#   systemd
#
# Configuration:
#   ~/.config/rofi/power.rasi
# ============================================================

set -u

ROFI_THEME="$HOME/.config/rofi/power.rasi"

# ------------------------------------------------------------
# Dependency checks
# ------------------------------------------------------------

if ! command -v rofi >/dev/null 2>&1; then
    notify-send \
        -u critical \
        "Power Menu" \
        "Rofi is not installed."
    exit 1
fi

if ! command -v systemctl >/dev/null 2>&1; then
    notify-send \
        -u critical \
        "Power Menu" \
        "systemctl is not available."
    exit 1
fi

# ------------------------------------------------------------
# Rofi theme
# ------------------------------------------------------------

ROFI_ARGS=(
    -dmenu
    -i
    -p "Power"
    -line-padding 4
    -hide-scrollbar
)

if [[ -f "$ROFI_THEME" ]]; then
    ROFI_ARGS+=(
        -theme "$ROFI_THEME"
    )
fi

# ------------------------------------------------------------
# Menu
# ------------------------------------------------------------

chosen="$(
    printf '%s\n' \
        "󰌾  Lock" \
        "󰍃  Logout" \
        "󰐥  Shutdown" \
        "󰜉  Reboot" \
        "󰤄  Suspend" \
        "󰒲  Hibernate" \
        "󰜺  Cancel" |
    rofi "${ROFI_ARGS[@]}"
)"

# ------------------------------------------------------------
# Actions
# ------------------------------------------------------------

case "$chosen" in

    "󰌾  Lock")
        if command -v loginctl >/dev/null 2>&1; then
            loginctl lock-session
        elif command -v gnome-screensaver-command >/dev/null 2>&1; then
            gnome-screensaver-command --lock
        fi
        ;;

    "󰍃  Logout")
        loginctl terminate-user "$USER"
        ;;

    "󰐥  Shutdown")
        systemctl poweroff
        ;;

    "󰜉  Reboot")
        systemctl reboot
        ;;

    "󰤄  Suspend")
        systemctl suspend
        ;;

    "󰒲  Hibernate")
        systemctl hibernate
        ;;

    *)
        exit 0
        ;;

esac
```
